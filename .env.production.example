# === Pavelo Production Environment ===
# Copy this file to .env.production and fill in all values.

# === Database ===
DATABASE_URL=postgresql://user:password@host:5432/pavelo

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Redis ===
REDIS_URL=redis://user:password@host:6379

# === OpenAI ===
OPENAI_API_KEY=sk-...

# === Qdrant ===
QDRANT_URL=https://your-qdrant-instance:6333
QDRANT_API_KEY=your-qdrant-api-key

# === LiveKit ===
LIVEKIT_URL=wss://your-livekit-instance
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret

# === Deepgram (STT) ===
DEEPGRAM_API_KEY=your-deepgram-key

# === Cartesia (TTS) ===
CARTESIA_API_KEY=your-cartesia-key

# === Mapbox ===
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# === App Config ===
NODE_ENV=production
API_PORT=4000
AGENT_PORT=8000
ML_PORT=8001
CORS_ORIGINS=https://pavelo.io,https://www.pavelo.io

# === URLs (internal service-to-service) ===
NEXT_PUBLIC_API_URL=https://api.pavelo.io
ML_SERVICE_URL=http://ml:8001
AGENT_SERVICE_URL=http://agent:8000
