// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User account — maps to Supabase Auth user
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(buyer)
  avatarUrl String?  @map("avatar_url")
  phone     String?

  // Buyer preferences (JSON)
  preferences Json? @default("{}")
  languagePreference String @default("en") @map("language_preference")

  // Relations
  properties    Property[]
  savedSearches SavedSearch[]
  searchEvents  SearchEvent[]
  conversations Conversation[]
  voiceSessions VoiceSession[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

/// Property listing — full real estate attributes
model Property {
  id           String         @id @default(uuid()) @db.Uuid
  title        String
  description  String?        @db.Text
  price        Int
  propertyType PropertyType   @map("property_type")
  status       PropertyStatus @default(for_sale)
  bedrooms     Int
  bathrooms    Int
  squareFeet   Int?           @map("square_feet")
  yearBuilt    Int?           @map("year_built")

  // Address
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  postcode     String
  county       String?
  country      String  @default("UK")

  // Coordinates
  latitude  Float?
  longitude Float?

  // Media & features
  images   String[] @default([])
  features String[] @default([])

  // Listing metadata
  listingDate DateTime? @map("listing_date")
  epcRating   String?   @map("epc_rating")
  tenure      Tenure?
  councilTaxBand String? @map("council_tax_band")

  // Relations
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @map("owner_id") @db.Uuid

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([postcode])
  @@index([city])
  @@index([propertyType])
  @@index([status])
  @@index([price])
  @@index([ownerId])
  @@index([bedrooms])
  @@index([createdAt])
  @@map("properties")
}

/// Saved search — stores user search params for alerts (S4-07)
model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  name      String   @default("Untitled Search")
  query     String
  filters   Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  lastRunAt DateTime? @map("last_run_at")
  matchCount Int     @default(0) @map("match_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isActive])
  @@map("saved_searches")
}

/// Search event log — analytics (S4-09)
model SearchEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id])
  query        String
  filters      Json     @default("{}")
  resultCount  Int      @default(0) @map("result_count")
  clickedIds   String[] @default([]) @map("clicked_ids")
  source       String   @default("web") // web, agent, api
  durationMs   Int?     @map("duration_ms")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([query])
  @@map("search_events")
}

// === Enums ===

enum UserRole {
  buyer
  seller
  agent

  @@map("user_role")
}

enum PropertyType {
  detached
  semi_detached @map("semi-detached")
  terraced
  flat
  bungalow
  cottage
  mansion
  other

  @@map("property_type")
}

enum PropertyStatus {
  for_sale
  under_offer
  sold_stc
  sold
  withdrawn

  @@map("property_status")
}

enum Tenure {
  freehold
  leasehold
  share_of_freehold @map("share-of-freehold")

  @@map("tenure")
}

/// Conversation — a chat session between user and Xara (S5-03)
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  metadata  Json     @default("{}")

  // Relations
  messages  Message[]
  voiceSessions VoiceSession[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([createdAt])
  @@map("conversations")
}

/// Message — individual message in a conversation (S5-03)
model Message {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String   @db.Text
  source          String   @default("text") // "text" or "voice" (S6-06)
  metadata        Json     @default("{}")
  visualPayloads  Json     @default("[]") @map("visual_payloads")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

/// Voice session — tracks active/completed voice calls (S6-07)
model VoiceSession {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  user            User               @relation(fields: [userId], references: [id])
  conversationId  String?            @map("conversation_id") @db.Uuid
  conversation    Conversation?      @relation(fields: [conversationId], references: [id])
  roomName        String             @unique @map("room_name")
  status          VoiceSessionStatus @default(active)
  language        String             @default("en")
  recordingConsent Boolean           @default(false) @map("recording_consent")

  // Metrics
  startedAt       DateTime           @default(now()) @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  durationSecs    Int?               @map("duration_secs")
  interruptionCount Int              @default(0) @map("interruption_count")
  toolCallCount   Int                @default(0) @map("tool_call_count")

  // Metadata: TTFB, WER, etc.
  metadata        Json               @default("{}")

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([roomName])
  @@map("voice_sessions")
}

/// Voice session status enum
enum VoiceSessionStatus {
  active
  ended
  failed
  timeout

  @@map("voice_session_status")
}

/// Message role enum
enum MessageRole {
  user
  assistant
  system
  tool

  @@map("message_role")
}

/// UserProfile — consolidated cross-session memory profile (S8-01)
model UserProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  
  // Consolidated preferences
  preferences     Json     @default("{}") // { budgetMin, budgetMax, preferredAreas, propertyTypes, styles, dealBreakers, ... }
  budgetMin       Int?     @map("budget_min")
  budgetMax       Int?     @map("budget_max")
  preferredAreas  String[] @default([]) @map("preferred_areas")
  propertyStyles  String[] @default([]) @map("property_styles")
  propertyTypes   String[] @default([]) @map("property_types")
  dealBreakers    String[] @default([]) @map("deal_breakers")
  
  // Intent patterns
  intentPatterns  Json     @default("{}") @map("intent_patterns") // { search: 5, valuation: 2, ... }
  sentimentScore  Float?   @map("sentiment_score") // -1 to 1 aggregate
  
  // Memory timeline
  memories        Json     @default("[]") // [{ fact, source, learnedAt, category }]
  
  // Consolidation metadata
  lastConsolidatedAt DateTime? @map("last_consolidated_at")
  consolidationCount Int      @default(0) @map("consolidation_count")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_profiles")
}

/// ViewingBooking — property viewing appointments (S8-06)
model ViewingBooking {
  id          String              @id @default(uuid()) @db.Uuid
  propertyId  String              @map("property_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  date        DateTime
  time        String              // e.g. "10:00", "14:30"
  status      ViewingBookingStatus @default(pending)
  notes       String?             @db.Text
  
  // Confirmation
  confirmedAt DateTime?           @map("confirmed_at")
  cancelledAt DateTime?           @map("cancelled_at")
  cancelReason String?            @map("cancel_reason")
  
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("viewing_bookings")
}

/// ViewingBooking status enum
enum ViewingBookingStatus {
  pending
  confirmed
  cancelled
  completed
  no_show

  @@map("viewing_booking_status")
}

/// PushSubscription — Web Push API subscriptions (S8-10)
model PushSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  endpoint    String   @unique
  p256dh      String   // public key
  auth        String   // auth secret
  
  // Notification preferences
  preferences Json     @default("{\"newMatches\":true,\"priceDrops\":true,\"viewingReminders\":true}") 
  
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

/// SavedProperty — user's saved/shortlisted properties (S8-09)
model SavedProperty {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  propertyId  String              @map("property_id") @db.Uuid
  column      SavedPropertyColumn @default(interested)
  position    Int                 @default(0) // ordering within column
  notes       String?             @db.Text
  tags        String[]            @default([])
  
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([column])
  @@map("saved_properties")
}

/// SavedProperty column enum
enum SavedPropertyColumn {
  interested
  shortlisted
  visited
  rejected

  @@map("saved_property_column")
}

/// ValuationReport — AI-generated property valuation (S8-04)
model ValuationReport {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  propertyId      String?  @map("property_id") @db.Uuid
  
  // Property details (snapshot at valuation time)
  address         String
  postcode        String
  propertyType    String   @map("property_type")
  bedrooms        Int
  bathrooms       Int
  squareFeet      Int?     @map("square_feet")
  
  // Valuation results
  estimateLow     Int      @map("estimate_low")
  estimateMid     Int      @map("estimate_mid")
  estimateHigh    Int      @map("estimate_high")
  confidence      Float    // 0-1
  methodology     String   @db.Text
  
  // Comparable data
  comparables     Json     @default("[]") // [{ address, price, sqft, distance, date }]
  marketTrend     String?  @map("market_trend") // "up", "stable", "down"
  pricePerSqft    Int?     @map("price_per_sqft")
  
  // Share
  shareToken      String?  @unique @map("share_token")
  
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([postcode])
  @@index([shareToken])
  @@map("valuation_reports")
}
