// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User account — maps to Supabase Auth user
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(buyer)
  avatarUrl String?  @map("avatar_url")
  phone     String?

  // Buyer preferences (JSON)
  preferences Json? @default("{}")
  languagePreference String @default("en") @map("language_preference")

  // Relations
  properties    Property[]
  savedSearches SavedSearch[]
  searchEvents  SearchEvent[]
  conversations Conversation[]
  voiceSessions VoiceSession[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

/// Property listing — full real estate attributes
model Property {
  id           String         @id @default(uuid()) @db.Uuid
  title        String
  description  String?        @db.Text
  price        Int
  propertyType PropertyType   @map("property_type")
  status       PropertyStatus @default(for_sale)
  bedrooms     Int
  bathrooms    Int
  squareFeet   Int?           @map("square_feet")
  yearBuilt    Int?           @map("year_built")

  // Address
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  postcode     String
  county       String?
  country      String  @default("UK")

  // Coordinates
  latitude  Float?
  longitude Float?

  // Media & features
  images   String[] @default([])
  features String[] @default([])

  // Listing metadata
  listingDate DateTime? @map("listing_date")
  epcRating   String?   @map("epc_rating")
  tenure      Tenure?
  councilTaxBand String? @map("council_tax_band")

  // Relations
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @map("owner_id") @db.Uuid

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([postcode])
  @@index([city])
  @@index([propertyType])
  @@index([status])
  @@index([price])
  @@index([ownerId])
  @@index([bedrooms])
  @@index([createdAt])
  @@map("properties")
}

/// Saved search — stores user search params for alerts (S4-07)
model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  name      String   @default("Untitled Search")
  query     String
  filters   Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  lastRunAt DateTime? @map("last_run_at")
  matchCount Int     @default(0) @map("match_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isActive])
  @@map("saved_searches")
}

/// Search event log — analytics (S4-09)
model SearchEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id])
  query        String
  filters      Json     @default("{}")
  resultCount  Int      @default(0) @map("result_count")
  clickedIds   String[] @default([]) @map("clicked_ids")
  source       String   @default("web") // web, agent, api
  durationMs   Int?     @map("duration_ms")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([query])
  @@map("search_events")
}

// === Enums ===

enum UserRole {
  buyer
  seller
  agent

  @@map("user_role")
}

enum PropertyType {
  detached
  semi_detached @map("semi-detached")
  terraced
  flat
  bungalow
  cottage
  mansion
  other

  @@map("property_type")
}

enum PropertyStatus {
  for_sale
  under_offer
  sold_stc
  sold
  withdrawn

  @@map("property_status")
}

enum Tenure {
  freehold
  leasehold
  share_of_freehold @map("share-of-freehold")

  @@map("tenure")
}

/// Conversation — a chat session between user and Xara (S5-03)
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  metadata  Json     @default("{}")

  // Relations
  messages  Message[]
  voiceSessions VoiceSession[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([createdAt])
  @@map("conversations")
}

/// Message — individual message in a conversation (S5-03)
model Message {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String   @db.Text
  source          String   @default("text") // "text" or "voice" (S6-06)
  metadata        Json     @default("{}")
  visualPayloads  Json     @default("[]") @map("visual_payloads")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

/// Voice session — tracks active/completed voice calls (S6-07)
model VoiceSession {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  user            User               @relation(fields: [userId], references: [id])
  conversationId  String?            @map("conversation_id") @db.Uuid
  conversation    Conversation?      @relation(fields: [conversationId], references: [id])
  roomName        String             @unique @map("room_name")
  status          VoiceSessionStatus @default(active)
  language        String             @default("en")
  recordingConsent Boolean           @default(false) @map("recording_consent")

  // Metrics
  startedAt       DateTime           @default(now()) @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  durationSecs    Int?               @map("duration_secs")
  interruptionCount Int              @default(0) @map("interruption_count")
  toolCallCount   Int                @default(0) @map("tool_call_count")

  // Metadata: TTFB, WER, etc.
  metadata        Json               @default("{}")

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([roomName])
  @@map("voice_sessions")
}

/// Voice session status enum
enum VoiceSessionStatus {
  active
  ended
  failed
  timeout

  @@map("voice_session_status")
}

/// Message role enum
enum MessageRole {
  user
  assistant
  system
  tool

  @@map("message_role")
}

/// UserProfile — consolidated cross-session memory profile (S8-01)
model UserProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  
  // Consolidated preferences
  preferences     Json     @default("{}") // { budgetMin, budgetMax, preferredAreas, propertyTypes, styles, dealBreakers, ... }
  budgetMin       Int?     @map("budget_min")
  budgetMax       Int?     @map("budget_max")
  preferredAreas  String[] @default([]) @map("preferred_areas")
  propertyStyles  String[] @default([]) @map("property_styles")
  propertyTypes   String[] @default([]) @map("property_types")
  dealBreakers    String[] @default([]) @map("deal_breakers")
  
  // Intent patterns
  intentPatterns  Json     @default("{}") @map("intent_patterns") // { search: 5, valuation: 2, ... }
  sentimentScore  Float?   @map("sentiment_score") // -1 to 1 aggregate
  
  // Memory timeline
  memories        Json     @default("[]") // [{ fact, source, learnedAt, category }]
  
  // Consolidation metadata
  lastConsolidatedAt DateTime? @map("last_consolidated_at")
  consolidationCount Int      @default(0) @map("consolidation_count")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_profiles")
}

/// ViewingBooking — property viewing appointments (S8-06)
model ViewingBooking {
  id          String              @id @default(uuid()) @db.Uuid
  propertyId  String              @map("property_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  date        DateTime
  time        String              // e.g. "10:00", "14:30"
  status      ViewingBookingStatus @default(pending)
  notes       String?             @db.Text
  
  // Confirmation
  confirmedAt DateTime?           @map("confirmed_at")
  cancelledAt DateTime?           @map("cancelled_at")
  cancelReason String?            @map("cancel_reason")
  
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("viewing_bookings")
}

/// ViewingBooking status enum
enum ViewingBookingStatus {
  pending
  confirmed
  cancelled
  completed
  no_show

  @@map("viewing_booking_status")
}

/// PushSubscription — Web Push API subscriptions (S8-10)
model PushSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  endpoint    String   @unique
  p256dh      String   // public key
  auth        String   // auth secret
  
  // Notification preferences
  preferences Json     @default("{\"newMatches\":true,\"priceDrops\":true,\"viewingReminders\":true}") 
  
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

/// SavedProperty — user's saved/shortlisted properties (S8-09)
model SavedProperty {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  propertyId  String              @map("property_id") @db.Uuid
  column      SavedPropertyColumn @default(interested)
  position    Int                 @default(0) // ordering within column
  notes       String?             @db.Text
  tags        String[]            @default([])
  
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([column])
  @@map("saved_properties")
}

/// SavedProperty column enum
enum SavedPropertyColumn {
  interested
  shortlisted
  visited
  rejected

  @@map("saved_property_column")
}

/// ValuationReport — AI-generated property valuation (S8-04)
model ValuationReport {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  propertyId      String?  @map("property_id") @db.Uuid
  
  // Property details (snapshot at valuation time)
  address         String
  postcode        String
  propertyType    String   @map("property_type")
  bedrooms        Int
  bathrooms       Int
  squareFeet      Int?     @map("square_feet")
  
  // Valuation results
  estimateLow     Int      @map("estimate_low")
  estimateMid     Int      @map("estimate_mid")
  estimateHigh    Int      @map("estimate_high")
  confidence      Float    // 0-1
  methodology     String   @db.Text
  
  // Comparable data
  comparables     Json     @default("[]") // [{ address, price, sqft, distance, date }]
  marketTrend     String?  @map("market_trend") // "up", "stable", "down"
  pricePerSqft    Int?     @map("price_per_sqft")
  
  // Share
  shareToken      String?  @unique @map("share_token")
  
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([postcode])
  @@index([shareToken])
  @@map("valuation_reports")
}

// ═══════════════════════════════════════════════════════════
// Sprint 9 — Agency, B2B & Integrations
// ═══════════════════════════════════════════════════════════

/// Agency — multi-tenant B2B organisation (S9-06)
model Agency {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  plan         AgencyPlan @default(starter)
  billingEmail String   @map("billing_email")
  
  // Usage counters
  conversationCount Int  @default(0) @map("conversation_count")
  voiceMinutes      Int  @default(0) @map("voice_minutes")
  propertyCount     Int  @default(0) @map("property_count")
  
  // Relations
  members       AgencyMember[]
  config        AgencyConfig?
  webhooks      WebhookConfig[]
  leads         Lead[]
  handovers     Handover[]
  subscription  Subscription?
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([plan])
  @@map("agencies")
}

/// Agency plan tiers (S9-07)
enum AgencyPlan {
  starter
  growth
  enterprise

  @@map("agency_plan")
}

/// AgencyMember — links users to agencies with roles (S9-01)
model AgencyMember {
  id        String          @id @default(uuid()) @db.Uuid
  agencyId  String          @map("agency_id") @db.Uuid
  agency    Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id") @db.Uuid
  role      AgencyMemberRole @default(agent)
  name      String
  email     String
  
  invitedAt  DateTime?      @map("invited_at")
  joinedAt   DateTime?      @map("joined_at")
  
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@unique([agencyId, userId])
  @@index([agencyId])
  @@index([userId])
  @@map("agency_members")
}

/// Agency member roles
enum AgencyMemberRole {
  admin
  agent
  viewer

  @@map("agency_member_role")
}

/// AgencyConfig — white-label branding (S9-05)
model AgencyConfig {
  id            String  @id @default(uuid()) @db.Uuid
  agencyId      String  @unique @map("agency_id") @db.Uuid
  agency        Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  // Branding
  logo          String?
  primaryColor  String  @default("#1B3A6B") @map("primary_color")
  accentColor   String  @default("#2E86AB") @map("accent_color")
  personaName   String  @default("Xara") @map("persona_name")
  customDomain  String? @map("custom_domain")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([agencyId])
  @@map("agency_configs")
}

/// Lead — buyer inquiry tracking (S9-01)
model Lead {
  id          String     @id @default(uuid()) @db.Uuid
  agencyId    String     @map("agency_id") @db.Uuid
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  // Contact info
  name        String
  email       String?
  phone       String?
  
  // Lead details
  status      LeadStatus @default(new)
  source      String     @default("xara") // xara, website, referral, manual
  propertyId  String?    @map("property_id") @db.Uuid
  notes       String?    @db.Text
  budget      Int?
  
  // Conversation reference
  conversationId String? @map("conversation_id") @db.Uuid
  
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([agencyId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

/// Lead status pipeline
enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost

  @@map("lead_status")
}

/// Handover — human agent handover requests (S9-03)
model Handover {
  id              String          @id @default(uuid()) @db.Uuid
  agencyId        String          @map("agency_id") @db.Uuid
  agency          Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  conversationId  String          @map("conversation_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  
  // Handover details
  status          HandoverStatus  @default(pending)
  reason          String          // "user_requested", "low_confidence", "booking_confirmation"
  contextSummary  String?         @db.Text @map("context_summary")
  userPreferences Json            @default("{}") @map("user_preferences")
  propertiesDiscussed String[]    @default([]) @map("properties_discussed")
  
  // Assignment
  assignedTo      String?         @map("assigned_to") @db.Uuid
  acceptedAt      DateTime?       @map("accepted_at")
  completedAt     DateTime?       @map("completed_at")
  
  // LiveKit room for warm transfer
  roomName        String?         @map("room_name")
  
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([agencyId])
  @@index([status])
  @@index([conversationId])
  @@map("handovers")
}

/// Handover status
enum HandoverStatus {
  pending
  accepted
  in_progress
  completed

  @@map("handover_status")
}

/// WebhookConfig — CRM webhook subscriptions (S9-04)
model WebhookConfig {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  url       String
  secret    String
  events    String[] @default([]) // ["lead.created", "viewing.booked", "valuation.requested", "handover.requested"]
  active    Boolean  @default(true)
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([agencyId])
  @@index([active])
  @@map("webhook_configs")
}

/// WebhookDelivery — delivery log (S9-04)
model WebhookDelivery {
  id           String   @id @default(uuid()) @db.Uuid
  webhookId    String   @map("webhook_id") @db.Uuid
  webhook      WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  
  // Delivery status
  statusCode   Int?     @map("status_code")
  response     String?  @db.Text
  success      Boolean  @default(false)
  attempts     Int      @default(0)
  lastAttempt  DateTime? @map("last_attempt")
  
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// Subscription — Stripe billing (S9-07)
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  agencyId          String             @unique @map("agency_id") @db.Uuid
  agency            Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  stripeCustomerId  String             @map("stripe_customer_id")
  stripePriceId     String             @map("stripe_price_id")
  stripeSubscriptionId String?         @map("stripe_subscription_id")
  status            SubscriptionStatus @default(active)
  
  currentPeriodStart DateTime?         @map("current_period_start")
  currentPeriodEnd   DateTime?         @map("current_period_end")
  cancelledAt        DateTime?         @map("cancelled_at")
  
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([agencyId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

/// Subscription status
enum SubscriptionStatus {
  active
  past_due
  cancelled
  trialing

  @@map("subscription_status")
}

/// Feedback — user feedback on agent responses (S9-08)
model Feedback {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  
  rating      Int      // 1 = thumbs down, 5 = thumbs up
  correction  String?  @db.Text // "That's not right" → correction text
  comment     String?  @db.Text
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@map("feedbacks")
}
